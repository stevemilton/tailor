{
  "manifest_version": 3,
  "name": "Tailor – AI Job Applications",
  "version": "1.0.0",
  "description": "Tailor your CV and cover letter to any LinkedIn job in one click.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.mistral.ai/*",
    "https://api.groq.com/*",
    "https://api.cohere.ai/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
